# ============================================================
# B-CORE FORM 環境変数一覧
#
# ローカル開発では
#   - このファイルを .env.local にコピー（NEXT_PUBLIC_〜 とサーバー用の値）
#   - シークレットは .dev.vars にも書ける（wrangler用）
# 本番（Cloudflare Workers）では
#   - NEXT_PUBLIC_〜 は「ビルド時の環境変数」（Workers Builds のビルド設定）に設定
#   - それ以外のシークレットは「変数とシークレット」（実行環境）に設定
# ============================================================

# --- Supabase（認証・データベース） ---
# Supabaseダッシュボード → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://rllpjenzdxhpwrtispye.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...（anon public キー）
# Service Role キー（秘密。サーバー専用。RLSを越えて読み書きできる）
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Stripe（決済はHP側。ここではWebhook受信と照合のみ） ---
# StripeのWebhookエンドポイント（このサイトの /api/stripe/webhook）を登録した時に発行される whsec_
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx
# テストモード用（任意）
STRIPE_WEBHOOK_SECRET_TEST=
# 通知の順番が前後してメールが取れない時にStripeへ問い合わせるためのキー（任意・推奨）
STRIPE_SECRET_KEY=
STRIPE_SECRET_KEY_TEST=
# プラン判定（Stripe商品カタログの price_xxx）
PRICE_ONLINE=
PRICE_OFFLINE=
# Stripeの支払いリンク（HPと同じ buy.stripe.com のURL）。
# 設定すると未契約者への案内に「申し込みボタン」が出て、
# ログイン中のメールアドレスを決済画面に自動入力する（メール照合ずれの防止）
STRIPE_LINK_ONLINE=
STRIPE_LINK_OFFLINE=

# --- Cloudflare Stream（動画配信） ---
# CloudflareダッシュボードのアカウントID
CLOUDFLARE_ACCOUNT_ID=0361CE13cde5C4170b9639ed5e745C3E
# 「Stream:編集」権限を付けたAPIトークン（秘密）
STREAM_API_TOKEN=
# Stream のカスタマーサブドメイン。次のどの書き方でもよい（コード側で吸収する）
#   7cf4k7owbwzz9 / customer-7cf4k7owbwzz9 / 7cf4k7owbwzz9.cloudflarestream.com
STREAM_CUSTOMER_CODE=7cf4k7owbwzz9.cloudflarestream.com
# 署名付きURL用キー。POST /accounts/{id}/stream/keys で作成した時の id と jwk
STREAM_SIGNING_KEY_ID=
STREAM_SIGNING_KEY_JWK=（base64のJWK。秘密）

# --- Notion（講座・動画の台帳） ---
# https://www.notion.so/my-integrations で作った内部インテグレーションのトークン（秘密）
# 台帳データベースにそのインテグレーションを「接続」しておくこと
NOTION_TOKEN=ntn_xxxxxxxx
NOTION_COURSES_DB_ID=
NOTION_VIDEOS_DB_ID=

# --- 管理者 ---
# 管理画面に入れるメールアドレス（カンマ区切り）
ADMIN_EMAILS=yuta17t@gmail.com

# --- サイト設定 ---
SITE_NAME=B-CORE FORM
MARKETING_SITE_URL=https://b-core.space
